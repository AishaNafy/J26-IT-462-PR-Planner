# Application
APP_ENV=development
APP_NAME=aquatic-intelligent-system

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MongoDB
MONGODB_URL=mongodb://localhost:27017/aquatic_intelligent

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend
API_BASE_URL=http://localhost:8000

# IoT
MQTT_BROKER=localhost
MQTT_PORT=1883

# Optional ESP32 ingestion key. Must match DEVICE_API_KEY in iot/.../secrets.h.
DEVICE_API_KEY=dev-device-key
