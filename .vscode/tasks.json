		{
			"label": "Aquatic Web App",
			"type": "shell",
			"command": "cd aquatic-intelligent-system/frontend && flutter run -d web-server --web-hostname 0.0.0.0 --web-port 8081 --dart-define=API_BASE_URL=http://localhost:8000",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}